<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Módulo de Clientes</h1>
    <p class="page-subtitle">Administración, registro y consulta de la cartera de clientes</p>
  </div>
  <div>
    <a href="/clientes/nuevo" class="btn btn-primary">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      <span>Nuevo Cliente</span>
    </a>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h2 class="card-title">Listado de Clientes</h2>
    <span style="font-size: 0.85rem; color: var(--text-muted);">Total: <strong><%= pagination.total %></strong> clientes</span>
  </div>

  <div class="card-body">
    <!-- Barra de Búsqueda y Filtros -->
    <form method="GET" action="/clientes" class="toolbar">
      <div class="filters-bar">
        <input 
          type="text" 
          name="search" 
          class="form-control search-input" 
          placeholder="Buscar por código, documento, nombre o distrito..." 
          value="<%= filters.search %>"
        >

        <select name="estado" class="form-control" style="width: 160px;">
          <option value="">Todos los estados</option>
          <option value="Activo" <%= filters.estado === 'Activo' ? 'selected' : '' %>>Activo</option>
          <option value="Inactivo" <%= filters.estado === 'Inactivo' ? 'selected' : '' %>>Inactivo</option>
        </select>

        <button type="submit" class="btn btn-secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <span>Filtrar</span>
        </button>

        <% if (filters.search || filters.estado) { %>
          <a href="/clientes" class="btn btn-secondary" style="background-color: #fff; border-color: var(--border-color);">Limpiar</a>
        <% } %>
      </div>
    </form>

    <!-- Tabla de Clientes -->
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Código</th>
            <th>Tipo / Doc</th>
            <th>Razón Social / Nombre</th>
            <th>Contacto</th>
            <th>Teléfono</th>
            <th>Ubicación</th>
            <th>Estado</th>
            <th style="text-align: right;">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (clients.length === 0) { %>
            <tr>
              <td colspan="8" style="text-align: center; padding: 40px; color: var(--text-muted);">
                No se encontraron clientes registrados con los criterios seleccionados.
              </td>
            </tr>
          <% } else { %>
            <% clients.forEach(client => { %>
              <tr>
                <td><strong><%= client.codigoCliente %></strong></td>
                <td>
                  <span style="font-size: 0.8rem; color: var(--text-muted);"><%= client.tipoDocumento %>:</span>
                  <strong><%= client.numeroDocumento %></strong>
                </td>
                <td>
                  <a href="/clientes/<%= client.id %>" style="color: var(--primary); font-weight: 600; text-decoration: none;">
                    <%= client.razonSocialNombre %>
                  </a>
                  <% if (client.correo) { %>
                    <div style="font-size: 0.78rem; color: var(--text-muted);"><%= client.correo %></div>
                  <% } %>
                </td>
                <td><%= client.contacto || '-' %></td>
                <td><%= client.telefono %></td>
                <td><%= client.distrito %>, <%= client.provincia %></td>
                <td>
                  <span class="badge <%= client.estado === 'Activo' ? 'badge-success' : 'badge-danger' %>">
                    <%= client.estado %>
                  </span>
                </td>
                <td style="text-align: right; white-space: nowrap;">
                  <a href="/clientes/<%= client.id %>" class="btn btn-secondary btn-sm" title="Ver Detalle">Ver</a>
                  <a href="/clientes/<%= client.id %>/editar" class="btn btn-secondary btn-sm" title="Editar">Editar</a>
                  
                  <form action="/clientes/<%= client.id %>/estado" method="POST" style="display: inline;" onsubmit="return confirm('¿Seguro que deseas cambiar el estado a <%= client.estado === 'Activo' ? 'Inactivo' : 'Activo' %>?');">
                    <button type="submit" class="btn btn-sm <%= client.estado === 'Activo' ? 'btn-secondary' : 'btn-success' %>" title="Cambiar Estado">
                      <%= client.estado === 'Activo' ? 'Desactivar' : 'Activar' %>
                    </button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Paginación -->
    <% if (pagination.totalPages > 1) { %>
      <div class="pagination">
        <div>
          Página <strong><%= pagination.page %></strong> de <strong><%= pagination.totalPages %></strong>
        </div>
        <div class="pagination-controls">
          <% if (pagination.page > 1) { %>
            <a href="/clientes?page=<%= pagination.page - 1 %>&search=<%= encodeURIComponent(filters.search) %>&estado=<%= encodeURIComponent(filters.estado) %>" class="page-link">&laquo; Anterior</a>
          <% } else { %>
            <span class="page-link disabled">&laquo; Anterior</span>
          <% } %>

          <% for (let p = 1; p <= pagination.totalPages; p++) { %>
            <a href="/clientes?page=<%= p %>&search=<%= encodeURIComponent(filters.search) %>&estado=<%= encodeURIComponent(filters.estado) %>" class="page-link <%= p === pagination.page ? 'active' : '' %>"><%= p %></a>
          <% } %>

          <% if (pagination.page < pagination.totalPages) { %>
            <a href="/clientes?page=<%= pagination.page + 1 %>&search=<%= encodeURIComponent(filters.search) %>&estado=<%= encodeURIComponent(filters.estado) %>" class="page-link">Siguiente &raquo;</a>
          <% } else { %>
            <span class="page-link disabled">Siguiente &raquo;</span>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
