<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Iniciar Sesión - Dale Delivery' %></title>
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body class="auth-page">
  <div class="auth-card">
    <div class="auth-header">
      <div class="auth-logo">DD</div>
      <h1 class="auth-title">Dale Delivery</h1>
      <p class="auth-subtitle">Acceso exclusivo para administradores y operadores</p>
    </div>

    <div class="auth-body">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error" style="margin-bottom: 20px;">
          <div style="display: flex; align-items: center; gap: 8px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            <span><%= error %></span>
          </div>
        </div>
      <% } %>

      <div class="auth-badge-demo">
        🔑 <strong>Credenciales por defecto:</strong><br>
        Usuario: <code>admin</code> &bull; Contraseña: <code>admin123</code>
      </div>

      <form action="/login" method="POST" autocomplete="off">
        <div class="auth-input-group">
          <label class="form-label" for="username">Usuario</label>
          <div style="position: relative; margin-top: 4px;">
            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <input 
              type="text" 
              id="username" 
              name="username" 
              class="auth-form-control" 
              placeholder="Ej. admin" 
              value="<%= typeof username !== 'undefined' ? username : '' %>"
              required 
              autofocus
            >
          </div>
        </div>

        <div class="auth-input-group">
          <label class="form-label" for="password">Contraseña</label>
          <div style="position: relative; margin-top: 4px;">
            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <input 
              type="password" 
              id="password" 
              name="password" 
              class="auth-form-control" 
              placeholder="••••••••" 
              required
            >
          </div>
        </div>

        <button type="submit" class="btn-auth" id="btn-login">
          Iniciar Sesión
        </button>
      </form>
    </div>

    <div class="auth-footer">
      &copy; 2026 Dale Delivery &bull; Sistema de Gestión de Courier
    </div>
  </div>
</body>
</html>
