<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Dashboard Operativo</h1>
    <p class="page-subtitle">Resumen y distribución operativa por empresa para la fecha <strong><%= metrics.selectedDate %></strong></p>
  </div>
  <div style="display: flex; gap: 10px; flex-wrap: wrap;">
    <a href="/envios/masivo" class="btn btn-secondary" style="border-color: var(--primary); color: var(--primary); font-weight: 700;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/></svg>
      <span>Envío Masivo (Tabla)</span>
    </a>
    <a href="/envios/nuevo" class="btn btn-primary">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      <span>Nuevo Envío</span>
    </a>
    <a href="/clientes/nuevo" class="btn btn-secondary">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
      <span>Nuevo Cliente</span>
    </a>
    <a href="/reportes/diario" class="btn btn-secondary">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
      <span>Reporte Diario</span>
    </a>
  </div>
</div>

<!-- Barra de Selector de Fecha de Registro -->
<div class="card" style="margin-bottom: 24px;">
  <div class="card-body" style="padding: 16px 24px;">
    <form method="GET" action="/dashboard" class="filters-bar" style="width: 100%; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
      <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
        <label for="fecha" style="font-weight: 700; font-size: 0.92rem; color: var(--text-main); display: flex; align-items: center; gap: 6px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <span>Fecha de Registro:</span>
        </label>
        <input 
          type="date" 
          name="fecha" 
          id="fecha" 
          class="form-control" 
          value="<%= metrics.selectedDate %>" 
          style="width: 170px; font-weight: 600; border-color: var(--primary);"
          onchange="this.form.submit()"
          title="Seleccione la fecha de registro para consultar las operaciones"
        >
        <button type="submit" class="btn btn-secondary btn-sm">
          <span>Consultar</span>
        </button>
      </div>

      <div style="display: flex; align-items: center; gap: 8px;">
        <% const todayStr = new Date().toISOString().split('T')[0]; %>
        <% if (metrics.selectedDate !== todayStr) { %>
          <a href="/dashboard" class="btn btn-secondary btn-sm" style="color: var(--primary); border-color: var(--primary);">
            Volver a Hoy (<%= todayStr %>)
          </a>
        <% } %>
        <span style="font-size: 0.85rem; color: var(--text-muted);">
          Empresas con envíos: <strong><%= metrics.companyMetrics.length %></strong>
        </span>
      </div>
    </form>
  </div>
</div>

<!-- Indicadores de la Fecha Seleccionada (KPI Cards) -->
<div class="stats-grid">
  <!-- Total Envíos de la Fecha -->
  <div class="stat-card">
    <div class="stat-icon blue">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16.5 9.4 7.55 4.24"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
    </div>
    <div class="stat-info">
      <span class="stat-label">Total Envíos</span>
      <span class="stat-value"><%= metrics.totalEnvios %></span>
    </div>
  </div>

  <!-- Empresas con Envíos -->
  <div class="stat-card">
    <div class="stat-icon orange">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
    </div>
    <div class="stat-info">
      <span class="stat-label">Empresas / Clientes</span>
      <span class="stat-value"><%= metrics.companyMetrics.length %></span>
    </div>
  </div>

  <!-- Registrados -->
  <div class="stat-card">
    <div class="stat-icon cyan">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    </div>
    <div class="stat-info">
      <span class="stat-label">Registrados</span>
      <span class="stat-value"><%= metrics.registrados %></span>
    </div>
  </div>

  <!-- En Proceso -->
  <div class="stat-card">
    <div class="stat-icon amber">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
    </div>
    <div class="stat-info">
      <span class="stat-label">En Proceso</span>
      <span class="stat-value"><%= metrics.enProceso %></span>
    </div>
  </div>

  <!-- Entregados -->
  <div class="stat-card">
    <div class="stat-icon green">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
    </div>
    <div class="stat-info">
      <span class="stat-label">Entregados</span>
      <span class="stat-value"><%= metrics.entregados %></span>
    </div>
  </div>

  <!-- Cancelados -->
  <div class="stat-card">
    <div class="stat-icon red">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
    </div>
    <div class="stat-info">
      <span class="stat-label">Cancelados</span>
      <span class="stat-value"><%= metrics.cancelados %></span>
    </div>
  </div>
</div>

<!-- Tabla Consolidada: Envíos por Empresa -->
<div class="card">
  <div class="card-header">
    <div>
      <h2 class="card-title" style="display: flex; align-items: center; gap: 8px;">
        <span>🏢 Distribución de Envíos por Empresa</span>
      </h2>
      <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 2px;">
        Consolidado de despachos registrados, entregados, en proceso y cancelados para el <strong><%= metrics.selectedDate %></strong>
      </div>
    </div>
    <a href="/reportes/diario?fecha=<%= metrics.selectedDate %>" class="btn btn-secondary btn-sm" title="Ver reporte diario completo con opción de exportar a Excel">
      <span>Ver en Reporte Diario &rarr;</span>
    </a>
  </div>

  <div class="card-body">
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Empresa / Cliente</th>
            <th>Doc. Fiscal</th>
            <th style="text-align: center;">Total Envíos</th>
            <th style="text-align: center;">Registrados</th>
            <th style="text-align: center;">En Proceso</th>
            <th style="text-align: center;">Entregados</th>
            <th style="text-align: center;">Cancelados</th>
            <th style="text-align: center; width: 140px;">Efectividad</th>
            <th style="text-align: right;">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (metrics.companyMetrics.length === 0) { %>
            <tr>
              <td colspan="9" style="text-align: center; padding: 40px; color: var(--text-muted);">
                <div style="font-size: 1.8rem; margin-bottom: 8px;">📦</div>
                <strong style="color: var(--text-main); font-size: 1rem;">No se encontraron envíos registrados para la fecha <%= metrics.selectedDate %></strong>
                <p style="font-size: 0.88rem; margin-top: 4px;">Seleccione otra fecha en el selector o registre un nuevo envío o lote masivo para empezar.</p>
                <div style="margin-top: 16px; display: flex; justify-content: center; gap: 10px;">
                  <a href="/envios/masivo" class="btn btn-primary btn-sm">Registro Masivo</a>
                  <a href="/envios/nuevo" class="btn btn-secondary btn-sm">Nuevo Envío Individual</a>
                </div>
              </td>
            </tr>
          <% } else { %>
            <% metrics.companyMetrics.forEach(c => { %>
              <tr>
                <td>
                  <a href="/clientes/<%= c.clienteId %>" style="color: var(--text-main); font-weight: 700; text-decoration: none;">
                    <%= c.clienteNombre %>
                  </a>
                  <div style="font-size: 0.78rem; color: var(--secondary); font-weight: 600;">
                    <%= c.clienteCodigo %>
                  </div>
                </td>
                <td style="color: var(--text-muted); font-size: 0.85rem;">
                  <%= c.clienteDocumento %>
                </td>
                <td style="text-align: center;">
                  <span style="font-size: 1.05rem; font-weight: 800; color: var(--secondary);">
                    <%= c.totalEnvios %>
                  </span>
                </td>
                <td style="text-align: center;">
                  <span class="badge badge-info">
                    <%= c.registrados %>
                  </span>
                </td>
                <td style="text-align: center;">
                  <span class="badge badge-warning">
                    <%= c.enProceso %>
                  </span>
                </td>
                <td style="text-align: center;">
                  <span class="badge badge-success">
                    <%= c.entregados %>
                  </span>
                </td>
                <td style="text-align: center;">
                  <% if (c.cancelados > 0) { %>
                    <span class="badge badge-danger"><%= c.cancelados %></span>
                  <% } else { %>
                    <span style="color: var(--text-light); font-size: 0.85rem;">0</span>
                  <% } %>
                </td>
                <td style="text-align: center;">
                  <div style="display: flex; align-items: center; justify-content: center; gap: 8px;">
                    <div style="flex: 1; background-color: #E2E8F0; border-radius: 9999px; height: 8px; overflow: hidden; min-width: 60px;">
                      <div style="background-color: <%= c.porcentajeEntrega >= 80 ? 'var(--success)' : (c.porcentajeEntrega >= 40 ? 'var(--warning)' : 'var(--primary)') %>; width: <%= c.porcentajeEntrega %>%; height: 100%; border-radius: 9999px;"></div>
                    </div>
                    <span style="font-size: 0.8rem; font-weight: 700; min-width: 34px;"><%= c.porcentajeEntrega %>%</span>
                  </div>
                </td>
                <td style="text-align: right; white-space: nowrap;">
                  <a href="/envios?fechaRegistro=<%= metrics.selectedDate %>&clienteId=<%= c.clienteId %>" class="btn btn-secondary btn-sm" title="Ver envíos de esta empresa">
                    Ver Envíos
                  </a>
                  <a href="/envios/masivo?clienteId=<%= c.clienteId %>" class="btn btn-secondary btn-sm" style="color: var(--primary);" title="Registrar envíos masivos para este cliente">
                    + Cargar Lote
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
