<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Dale Delivery | Courier Rápido, Seguro y Conectado' %></title>
  <meta name="description" content="Plataforma de gestión logística y courier nacional Dale Delivery. Envíos rápidos, seguros y conectados con seguimiento en tiempo real en todo el Perú.">
  
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Estilos del Sistema y Landing -->
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/landing.css">
</head>
<body class="landing-page">

  <!-- Efectos de Fondo Tecnológico -->
  <div class="tech-bg-effects" aria-hidden="true">
    <div class="tech-grid"></div>
    <div class="ambient-glow-1"></div>
    <div class="ambient-glow-2"></div>
    <div class="ambient-glow-3"></div>
  </div>

  <!-- ==========================================================================
       HEADER / NAVBAR
       ========================================================================== -->
  <header class="land-navbar">
    <div class="landing-container nav-wrapper">
      <a href="/" class="nav-brand" title="Dale Delivery - Inicio">
        <img src="/img/logo.svg" alt="Logo Dale Delivery" class="brand-logo-img">
        <div class="brand-text-group">
          <span class="brand-main-title">Dale<span>Delivery</span></span>
          <span class="brand-tagline">Courier Express &bull; Perú</span>
        </div>
      </a>

      <!-- Menú de Navegación -->
      <nav>
        <ul class="nav-menu" id="navMenu">
          <li><a href="#hero" class="nav-link">Inicio</a></li>
          <li><a href="#servicios" class="nav-link">Servicios</a></li>
          <li><a href="#como-funciona" class="nav-link">Cómo Funciona</a></li>
          <li><a href="#cobertura" class="nav-link">Cobertura</a></li>
          <li><a href="#tecnologia" class="nav-link">Tecnología</a></li>
          <li><a href="#contacto" class="nav-link">Contacto</a></li>
        </ul>
      </nav>

      <!-- Botón de Acción -->
      <div class="nav-actions">
        <% if (typeof isLoggedIn !== 'undefined' && isLoggedIn) { %>
          <a href="/dashboard" class="btn-nav-login">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="9"></rect>
              <rect x="14" y="3" width="7" height="5"></rect>
              <rect x="14" y="12" width="7" height="9"></rect>
              <rect x="3" y="16" width="7" height="5"></rect>
            </svg>
            <span>Ir al Dashboard</span>
          </a>
        <% } else { %>
          <a href="/login" class="btn-nav-login" id="btn-header-login">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
              <polyline points="10 17 15 12 10 7"></polyline>
              <line x1="15" y1="12" x2="3" y2="12"></line>
            </svg>
            <span>Iniciar Sesión</span>
          </a>
        <% } %>

        <button class="mobile-toggle" id="mobileToggle" aria-label="Abrir menú de navegación">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- ==========================================================================
       HERO PRINCIPAL + MAPA TECNOLÓGICO DEL PERÚ
       ========================================================================== -->
  <section class="hero-section" id="hero">
    <div class="landing-container">
      <div class="hero-grid">
        
        <!-- Columna de Texto & CTA -->
        <div class="hero-content">
          <div class="hero-badge">
            <span class="pulse-dot"></span>
            <span>RED LOGÍSTICA NACIONAL INTELIGENTE</span>
          </div>

          <h1 class="hero-title">
            TU ENVÍO.<br>
            <span class="title-gradient-orange">NUESTRA RUTA.</span>
          </h1>

          <p class="hero-description">
            Courier rápido, seguro y conectado. Gestionamos tus envíos y operaciones de distribución con tecnología de vanguardia y trazabilidad en tiempo real.
          </p>

          <div class="hero-cta-group">
            <% if (typeof isLoggedIn !== 'undefined' && isLoggedIn) { %>
              <a href="/dashboard" class="btn-hero-primary">
                <span>Ir al Dashboard</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            <% } else { %>
              <a href="/login" class="btn-hero-primary" id="btn-hero-login">
                <span>Realizar Envío</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
              <a href="/login" class="btn-hero-secondary">
                <span>Iniciar Sesión</span>
              </a>
            <% } %>
          </div>

          <!-- Mini Indicadores de Confianza -->
          <div class="hero-highlights">
            <div class="highlight-item">
              <span class="highlight-val">99.4<span>%</span></span>
              <span class="highlight-lbl">Efectividad de Entrega</span>
            </div>
            <div class="highlight-item">
              <span class="highlight-val">24<span>/7</span></span>
              <span class="highlight-lbl">Seguimiento en Vivo</span>
            </div>
            <div class="highlight-item">
              <span class="highlight-val">100<span>%</span></span>
              <span class="highlight-lbl">Cobertura Perú</span>
            </div>
          </div>
        </div>

        <!-- Columna del Mapa Logístico Estilizado del Perú -->
        <div class="map-visual-container">
          <div class="map-header-telemetry">
            <div class="telemetry-title">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
              <span>Red Logística Perú</span>
            </div>
            <div class="telemetry-badge-live">En Línea</div>
          </div>

          <!-- SVG Mapa Logístico Nacional del Perú (Cartografía Oficial 25 Departamentos) -->
          <svg class="peru-map-svg" viewBox="0 0 600 780" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="routeOrangeGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#FF7A00"/>
                <stop offset="100%" stop-color="#FF3D00"/>
              </linearGradient>
              <linearGradient id="routeCyanGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#00D2FF"/>
                <stop offset="100%" stop-color="#005BBE"/>
              </linearGradient>
              <linearGradient id="deptFillGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="rgba(10, 25, 55, 0.55)"/>
                <stop offset="100%" stop-color="rgba(6, 15, 38, 0.7)"/>
              </linearGradient>
              <filter id="glowCyan" x="-40%" y="-40%" width="180%" height="180%">
                <feGaussianBlur stdDeviation="3.5" result="blur"/>
                <feMerge>
                  <feMergeNode in="blur"/>
                  <feMergeNode in="SourceGraphic"/>
                </feMerge>
              </filter>
              <filter id="glowOrange" x="-40%" y="-40%" width="180%" height="180%">
                <feGaussianBlur stdDeviation="4.5" result="blur"/>
                <feMerge>
                  <feMergeNode in="blur"/>
                  <feMergeNode in="SourceGraphic"/>
                </feMerge>
              </filter>
            </defs>

