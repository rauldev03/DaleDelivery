<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>404 - Página no encontrada</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/components.css">
</head>
<body style="display: flex; align-items: center; justify-content: center; min-height: 100vh; text-align: center; padding: 20px;">
  <div class="card" style="max-width: 500px; padding: 40px;">
    <h1 style="font-size: 4rem; color: var(--primary); margin-bottom: 10px;">404</h1>
    <h2 style="margin-bottom: 12px;">Página no encontrada</h2>
    <p style="color: var(--text-muted); margin-bottom: 24px;"><%= typeof message !== 'undefined' ? message : 'El recurso solicitado no fue encontrado.' %></p>
    <a href="/dashboard" class="btn btn-primary">Volver al Inicio</a>
  </div>
</body>
</html>
