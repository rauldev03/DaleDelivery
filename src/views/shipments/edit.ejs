<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Editar Envío <%= shipment.codigoEnvio %></h1>
    <p class="page-subtitle">Modificación de información y cambio de estado del envío</p>
  </div>
  <div style="display: flex; gap: 10px;">
    <a href="/envios/<%= shipment.id %>" class="btn btn-secondary">
      Ver Ficha
    </a>
    <a href="/envios" class="btn btn-secondary">
      &larr; Volver al Listado
    </a>
  </div>
</div>

<% if (typeof errors !== 'undefined' && errors.length > 0) { %>
  <div class="alert alert-error">
    <div>
      <strong>Por favor corrija los siguientes errores:</strong>
      <ul style="margin-top: 6px; padding-left: 20px;">
        <% errors.forEach(err => { %>
          <li><%= err %></li>
        <% }); %>
      </ul>
    </div>
  </div>
<% } %>

<form action="/envios/<%= shipment.id %>/editar" method="POST" autocomplete="off">
  <!-- Sección 1: Datos Principales y Estado -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">1. Datos Principales y Estado Operativo</h2>
      <div>
        <span style="font-size: 0.85rem; color: var(--text-muted);">Código:</span>
        <span class="badge badge-info" style="font-size: 0.95rem; padding: 6px 12px;"><%= shipment.codigoEnvio %></span>
      </div>
    </div>
    <div class="card-body">
      <div class="form-grid">
        <!-- Estado Manual (Muy Importante) -->
        <div class="form-group col-full" style="background-color: var(--primary-light); padding: 16px; border-radius: var(--radius); border: 1px solid #bfdbfe;">
          <label class="form-label" for="estado" style="color: var(--primary); font-size: 1rem;">
            Estado Actual del Envío <span class="required">*</span>
          </label>
          <select name="estado" id="estado" class="form-control" style="font-weight: 600; font-size: 1rem;">
            <option value="Registrado" <%= shipment.estado === 'Registrado' ? 'selected' : '' %>>🔵 Registrado (En espera de despacho)</option>
            <option value="En proceso" <%= shipment.estado === 'En proceso' ? 'selected' : '' %>>🟡 En proceso (En ruta de entrega)</option>
            <option value="Entregado" <%= shipment.estado === 'Entregado' ? 'selected' : '' %>>🟢 Entregado (Entrega exitosa completada)</option>
            <option value="Cancelado" <%= shipment.estado === 'Cancelado' ? 'selected' : '' %>>🔴 Cancelado (Anulado u orden suspendida)</option>
          </select>
        </div>

        <!-- Cliente -->
        <div class="form-group col-full">
          <label class="form-label" for="clienteId">Cliente Emisor <span class="required">*</span></label>
          <select name="clienteId" id="clienteId" class="form-control" required>
            <% clients.forEach(c => { %>
              <option value="<%= c.id %>" <%= String(shipment.clienteId) === String(c.id) ? 'selected' : '' %>>
                <%= c.codigoCliente %> &bull; <%= c.razonSocialNombre %>
              </option>
            <% }); %>
          </select>
        </div>

        <!-- Fecha de Registro -->
        <div class="form-group">
          <label class="form-label" for="fechaRegistro">Fecha de Registro <span class="required">*</span></label>
          <input 
            type="date" 
            name="fechaRegistro" 
            id="fechaRegistro" 
            class="form-control" 
            value="<%= shipment.fechaRegistro %>" 
            required
          >
        </div>

        <!-- Fecha de Entrega -->
        <div class="form-group">
          <label class="form-label" for="fechaEntrega">Fecha de Entrega</label>
          <input 
            type="date" 
            name="fechaEntrega" 
            id="fechaEntrega" 
            class="form-control" 
            value="<%= shipment.fechaEntrega || '' %>"
          >
          <span style="font-size: 0.76rem; color: var(--text-muted);">Asignada automáticamente al marcar "Entregado" si se deja vacía.</span>
        </div>

        <!-- Tipo de Servicio -->
        <div class="form-group">
          <label class="form-label" for="tipoServicio">Tipo de Servicio <span class="required">*</span></label>
          <select name="tipoServicio" id="tipoServicio" class="form-control" required>
            <option value="Estándar" <%= shipment.tipoServicio === 'Estándar' ? 'selected' : '' %>>Estándar</option>
            <option value="Express" <%= shipment.tipoServicio === 'Express' ? 'selected' : '' %>>Express</option>
            <option value="Same Day" <%= shipment.tipoServicio === 'Same Day' ? 'selected' : '' %>>Same Day</option>
            <option value="Next Day" <%= shipment.tipoServicio === 'Next Day' ? 'selected' : '' %>>Next Day</option>
          </select>
        </div>
      </div>
    </div>
  </div>

  <!-- Sección 2: Datos del Destinatario -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">2. Datos del Destinatario</h2>
    </div>
    <div class="card-body">
      <div class="form-grid">
        <!-- Nombre del Destinatario -->
        <div class="form-group col-full">
          <label class="form-label" for="destinatarioNombre">Nombre Completo del Destinatario <span class="required">*</span></label>
          <input 
            type="text" 
            name="destinatarioNombre" 
            id="destinatarioNombre" 
            class="form-control" 
            value="<%= shipment.destinatarioNombre %>" 
            required
          >
        </div>

        <!-- Documento Opcional -->
        <div class="form-group">
          <label class="form-label" for="destinatarioDocumento">DNI / Documento del Destinatario</label>
          <input 
            type="text" 
            name="destinatarioDocumento" 
            id="destinatarioDocumento" 
            class="form-control" 
            value="<%= shipment.destinatarioDocumento || '' %>"
          >
        </div>

        <!-- Teléfono -->
        <div class="form-group">
          <label class="form-label" for="destinatarioTelefono">Teléfono / Celular del Destinatario <span class="required">*</span></label>
          <input 
            type="text" 
            name="destinatarioTelefono" 
            id="destinatarioTelefono" 
            class="form-control" 
            value="<%= shipment.destinatarioTelefono %>" 
            required
          >
        </div>

        <!-- Correo Electrónico -->
        <div class="form-group">
          <label class="form-label" for="destinatarioCorreo">Correo del Destinatario</label>
          <input 
            type="email" 
            name="destinatarioCorreo" 
            id="destinatarioCorreo" 
            class="form-control" 
            value="<%= shipment.destinatarioCorreo || '' %>"
          >
        </div>
      </div>
    </div>
  </div>

  <!-- Sección 3: Dirección de Entrega -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">3. Dirección de Entrega</h2>
    </div>
    <div class="card-body">
      <div class="form-grid">
        <!-- Dirección -->
        <div class="form-group col-full">
          <label class="form-label" for="direccion">Dirección de Entrega <span class="required">*</span></label>
          <input 
            type="text" 
            name="direccion" 
            id="direccion" 
            class="form-control" 
            value="<%= shipment.direccion %>" 
            required
          >
        </div>

        <!-- Referencia -->
        <div class="form-group col-full">
          <label class="form-label" for="referencia">Referencia</label>
          <input 
            type="text" 
            name="referencia" 
            id="referencia" 
            class="form-control" 
            value="<%= shipment.referencia || '' %>"
          >
        </div>

        <!-- Distrito -->
        <div class="form-group">
          <label class="form-label" for="distrito">Distrito <span class="required">*</span></label>
          <input 
            type="text" 
            name="distrito" 
            id="distrito" 
            list="distritos-lima"
            class="form-control" 
            value="<%= shipment.distrito %>" 
            required
          >
          <datalist id="distritos-lima">
            <% if (typeof districts !== 'undefined' && districts.length > 0) { %>
              <% districts.forEach(d => { %>
                <option value="<%= d %>"></option>
              <% }); %>
            <% } %>
          </datalist>
        </div>

        <!-- Provincia -->
        <div class="form-group">
          <label class="form-label" for="provincia">Provincia <span class="required">*</span></label>
          <input 
            type="text" 
            name="provincia" 
            id="provincia" 
            class="form-control" 
            value="<%= shipment.provincia %>" 
            required
          >
        </div>

        <!-- Departamento -->
        <div class="form-group">
          <label class="form-label" for="departamento">Departamento <span class="required">*</span></label>
          <input 
            type="text" 
            name="departamento" 
            id="departamento" 
            class="form-control" 
            value="<%= shipment.departamento %>" 
            required
          >
        </div>

        <!-- Link de Google Maps -->
        <div class="form-group">
          <label class="form-label" for="linkGoogleMaps">Link de Google Maps (Opcional) 📍</label>
          <input 
            type="url" 
            name="linkGoogleMaps" 
            id="linkGoogleMaps" 
            class="form-control" 
            placeholder="https://maps.app.goo.gl/..." 
            value="<%= shipment.linkGoogleMaps || shipment.link_google_maps || '' %>"
          >
        </div>

        <!-- Código Plus de Maps -->
        <div class="form-group">
          <label class="form-label" for="plusCode">Código Plus de Maps (Opcional) 🌐</label>
          <input 
            type="text" 
            name="plusCode" 
            id="plusCode" 
            class="form-control" 
            placeholder="Ej. 87G83W3M+2X" 
            value="<%= shipment.plusCode || shipment.plus_code || '' %>"
          >
        </div>
      </div>
    </div>
  </div>

  <!-- Sección 4: Datos de Paquetería -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">4. Datos del Paquete y Observaciones</h2>
    </div>
    <div class="card-body">
      <div class="form-grid">
        <!-- Cantidad de Paquetes -->
        <div class="form-group">
          <label class="form-label" for="cantidadPaquetes">Cantidad de Paquetes <span class="required">*</span></label>
          <input 
            type="number" 
            name="cantidadPaquetes" 
            id="cantidadPaquetes" 
            class="form-control" 
            min="1" 
            value="<%= shipment.cantidadPaquetes %>" 
            required
          >
        </div>

        <!-- Peso Opcional -->
        <div class="form-group">
          <label class="form-label" for="peso">Peso en Kg</label>
          <input 
            type="number" 
            step="0.01" 
            min="0" 
            name="peso" 
            id="peso" 
            class="form-control" 
            value="<%= shipment.peso %>"
          >
        </div>

        <!-- Descripción -->
        <div class="form-group col-full">
          <label class="form-label" for="descripcion">Descripción del Contenido</label>
          <textarea 
            name="descripcion" 
            id="descripcion" 
            class="form-control" 
            rows="2"
          ><%= shipment.descripcion || '' %></textarea>
        </div>

        <!-- Observaciones -->
        <div class="form-group col-full">
          <label class="form-label" for="observaciones">Observaciones</label>
          <textarea 
            name="observaciones" 
            id="observaciones" 
            class="form-control" 
            rows="2"
          ><%= shipment.observaciones || '' %></textarea>
        </div>
      </div>

      <!-- Datos de Auditoría -->
      <div class="audit-box">
        <div><strong>Registrado:</strong> <%= shipment.fechaCreacion %> por <%= shipment.creadoPor || 'Sistema' %></div>
        <div><strong>Última modificación:</strong> <%= shipment.fechaModificacion || 'Sin modificaciones' %> por <%= shipment.modificadoPor || '-' %></div>
      </div>

      <div class="form-actions">
        <a href="/envios" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary" id="btn-update-shipment">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
          <span>Guardar Cambios</span>
        </button>
      </div>
    </div>
  </div>
</form>

<%- include('../partials/footer') %>
